// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Postgres in every environment (Neon locally and in production) rather
// than SQLite locally / Postgres in prod — a provider mismatch between dev
// and prod is exactly the kind of thing that passes every local test and
// then breaks in a way that's hard to reproduce.
//
// url: the pooled connection string, used by Prisma Client at runtime.
// Serverless functions (Vercel) can spin up many concurrent instances, and
// each one opens its own connections — going through a pooler (Neon's
// built-in PgBouncer) keeps that from exhausting the database's direct
// connection limit. (app/db.server.ts additionally appends
// pgbouncer=true&connection_limit=1 to this at runtime, since the
// Neon-Vercel integration that injects DATABASE_URL doesn't include those
// params itself.)
// directUrl: the unpooled connection string, used only by the Prisma CLI
// (`migrate`, `db push`, etc.). Migrations use advisory locks that aren't
// supported through a transaction-mode pooler, so they need a direct
// connection. Named DATABASE_URL_UNPOOLED, not DIRECT_URL, to match what
// the Neon-Vercel integration actually injects — using its real name means
// this works with zero manual env var setup in Vercel.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model QuickBooksConnection {
  id                  String   @id @default(cuid())
  shop                String   @unique
  realmId             String
  accessToken         String
  refreshToken        String
  accessTokenExpires  DateTime
  refreshTokenExpires DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// One row per completed one-time Full Audit purchase, across all shops.
// Exists so we can count total audits sold and switch from intro ($49) to
// list ($79) pricing once the intro allotment is used up. chargeId is
// Shopify's AppPurchaseOneTime id, unique so the same purchase never gets
// counted twice across repeated report loads.
model AuditPurchase {
  id        String   @id @default(cuid())
  shop      String
  chargeId  String   @unique
  amount    Float
  createdAt DateTime @default(now())
}
