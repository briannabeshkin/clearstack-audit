# QuickBooks Online OAuth (sandbox) — from your app's Keys & OAuth page at
# https://developer.intuit.com/app/developer/dashboard
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

# Used only as a fallback when SHOPIFY_APP_URL isn't set (e.g. outside of
# `shopify app dev` — a production deploy behind its own domain). During
# `shopify app dev`, the redirect URI is derived automatically from
# SHOPIFY_APP_URL instead, since that's kept in sync with the current tunnel
# on every restart and this static value can't be.
QBO_REDIRECT_URI=https://example.com/app/qbo/callback

# Postgres (Neon) — same provider locally and in production. DATABASE_URL is
# the pooled connection string the app uses at runtime; DIRECT_URL is the
# unpooled one, used only by `prisma migrate`/`prisma db push`. Neon gives
# you both when you create a project (or via the Vercel integration, which
# writes these automatically to your Vercel env vars).
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

# Controls whether the $49/$79 purchase button charges a real card or a
# Shopify test charge. Unset (or anything other than the literal string
# "false") means test mode — that's the safe default. Set to exactly
# "false" to charge real money. Deliberately NOT derived from NODE_ENV:
# hosts set that to "production" automatically on deploy, which would
# otherwise flip real billing on without anyone asking for it.
BILLING_TEST_MODE=true

# The following are NOT in this file because `shopify app dev` manages them
# automatically in a separate .env it writes itself (SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, SCOPES, SHOPIFY_APP_URL). A production deployment
# (e.g. Vercel) isn't running `shopify app dev`, so all four have to be set
# by hand there — see the deployment notes for exact values.
